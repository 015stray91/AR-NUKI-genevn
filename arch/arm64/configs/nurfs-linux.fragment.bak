# NURFS: Native Unified RootFS - Linux-compat supplement
# Makes the kernel understand Linux natively alongside Android (no chroot/container)
# KIO-FUSE native (for AnyRealm Matrix arbitrary EXE - real NT env via VFS, not Wine)
CONFIG_FUSE_FS=y
CONFIG_CUSE=y
CONFIG_VIRTIO_FS=y
CONFIG_FUSE_DAX=y
# EUD (Embedded USB Debugger) - hardware interface for Matrix module telemetry (driver standalone, no KALLSYMS needed)
CONFIG_QCOM_EUD=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
# Disable autoksyms dynamic trim - eliminates include/generated/autoksyms.h generation that crashes host kallsyms
CONFIG_AUTOKSYMS=n
# Lean out tracing/profiling/debugging that bloats internal header structures on LZ4+ZSTD dual compression
CONFIG_FTRACE=n
CONFIG_PROFILING=n
CONFIG_BLK_DEV_IO_TRACE=n
CONFIG_DEBUG_INFO=n
CONFIG_BUG=n
# Strip AMDGPU/RADEON (phone is Qualcomm Snapdragon, not AMD)
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_RADEON=n
# KSU must survive the merge - ensure base sacred flags don't get overridden by middle configs
CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_ZEROMOUNT=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_USER_NS=y
CONFIG_IPC_NS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_FHANDLE=y
CONFIG_SQUASHFS=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ASHMEM=y
CONFIG_ZRAM=y
# Disable ANDROID_SYMLINKS - hardcodes /mnt/disks/build-disk/.../android/common path from AOSP build server
# That path doesn't exist on CI runner - causes abi_symbollist.raw whitelist not found
CONFIG_ANDROID_SYMLINKS=n
# Disable MODVERSIONS - depends on abi_symbollist.raw from GKI android/common tree
CONFIG_MODVERSIONS=n
# Systemd + Debian image builder (DIB) hard requirements
# Kernel image (Colonel) -> LZ4 (fast boot, vendor_boot ramdisk expects lz4)
CONFIG_KERNEL_LZ4=y
# CONFIG_KERNEL_GZIP is not set
# CONFIG_KERNEL_ZSTD is not set
# Stage-2 ramdisk (initramfs inside vendor_boot) -> ZSTD (NetHunter binaries compact)
CONFIG_INITRAMFS_COMPRESSION_ZSTD=y
# CONFIG_INITRAMFS_COMPRESSION_LZ4 is not set
# CONFIG_INITRAMFS_COMPRESSION_GZIP is not set
CONFIG_RD_ZSTD=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_LZ4 is not set
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_FHANDLE=y
CONFIG_IPC_NS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_AUTOFS4_FS=y
CONFIG_ANON_VMA_NAME=y
# Compressed read-only roots for NURFS live layers
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_FILE_DIRECT=y
# Optional but useful for flexible NURFS partitions
CONFIG_BTRFS_FS=m
CONFIG_BTRFS_FS_POSIX_ACL=y
