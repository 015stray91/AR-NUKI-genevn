# --- RUN NATIVE LINUX & EXTERNAL BINARIES ---
CONFIG_BINFMT_MISC=y
CONFIG_BINFMT_ELF=y
CONFIG_COMPAT_BINFMT_ELF=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_USER_NS=y

# --- WINDOWS & CROSS-PLATFORM SYSTEM SUPPORT ---
# Allows you to mount Windows/PC drives (NTFS/ExFat) with full speed
CONFIG_NTFS_FS=y
CONFIG_NTFS_RW=y
CONFIG_EXFAT_FS=y
CONFIG_CIFS=y
CONFIG_CIFS_XATTR=y

# --- THE UNCHAINED "HOME" ENVIRONMENT ---
# Allows the kernel to handle the complex permissions Linux tools expect
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y


# --- ZRAM SUPPORT ---
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZSMALLOC=y

# --- ZSWAP SUPPORT ---
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZBUD=y
CONFIG_Z3FOLD=y

# --- RECOMMENDED COMPRESSORS ---
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y

# --- ENSURE ZSWAP IS DISABLED ---
# CONFIG_ZSWAP is not set
